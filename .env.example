# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# TTS Configuration
TTS_ENGINE=coqui
TTS_MODEL=tts_models/multilingual/multi-dataset/xtts_v2
TTS_LANGUAGE=en
TTS_SPEED=1.0

# Web Application
WEB_HOST=127.0.0.1
WEB_PORT=8000
DEBUG=false

# Data Paths
DATA_DIR=./data
BOOKS_DIR=./data/books
AUDIO_DIR=./data/books
DATABASE_PATH=./data/databases/audiobook.db

# Scraper Configuration
SCRAPER_DELAY_SECONDS=2
SCRAPER_USER_AGENT=Mozilla/5.0 (compatible; AudiobookBot/1.0)
SCRAPER_RETRY_ATTEMPTS=3

# Logging
LOG_LEVEL=INFO
LOG_DIR=./logs
