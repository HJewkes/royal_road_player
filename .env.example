# Database Configuration
POSTGRES_PASSWORD=audiobook_password

# Web Service
WEB_PORT=8000

# TTS Configuration
TTS_GPU=false
TORCH_VERSION=cpu
TTS_FINE_TUNED_MODEL=

# Audio Output
AUDIO_OUTPUT_FORMAT=m4b
AUDIO_BITRATE=128k

# Worker Resources
WORKER_CPUS=2
WORKER_MEMORY=4G

# Optional: Use SQLite instead of PostgreSQL (leave DATABASE_URL empty)
# DATABASE_URL=
