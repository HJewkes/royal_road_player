<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.audiobook.autopull</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/hjewkes/projects/audiobook/scripts/autopull.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/hjewkes/projects/audiobook</string>

    <!-- Calendar minutes, not StartInterval: after a deep sleep this Mac's
         launchd left every StartInterval job "pended" indefinitely (2026-09-07),
         while calendar timers kept firing. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Minute</key><integer>1</integer></dict>
        <dict><key>Minute</key><integer>16</integer></dict>
        <dict><key>Minute</key><integer>31</integer></dict>
        <dict><key>Minute</key><integer>46</integer></dict>
    </array>

    <key>StandardOutPath</key>
    <string>/Users/hjewkes/projects/audiobook/logs/launchd-autopull.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/hjewkes/projects/audiobook/logs/launchd-autopull.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/hjewkes/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>/Users/hjewkes</string>
    </dict>
</dict>
</plist>
