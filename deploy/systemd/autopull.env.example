# Copy to ~/.config/audiobook/autopull.env. systemd reads it as EnvironmentFile:
# KEY=value only, no quotes, no spaces around "=", no shell expansion.
# 0 = shadow mode: render and build the feed locally, upload nothing.
AUTOPULL_PUBLISH=0
AUDIOBOOK_MAX_CONCURRENT_CHUNKS=4
AUDIOBOOK_HOST=127.0.0.1
# ntfy topic URL for phone notifications, e.g. https://ntfy.sh/<topic>
AUDIOBOOK_NTFY_URL=
# From `claude setup-token`, for headless commentary detection
CLAUDE_CODE_OAUTH_TOKEN=
# A claude config dir of its own, so no user plugins or hooks load
CLAUDE_CONFIG_DIR=
